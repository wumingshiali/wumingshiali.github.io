# 带 hash 的静态资源永久缓存（immutable）
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 头像文件名固定，内容很少变化 —— 长期缓存
/avatar-*.webp
  Cache-Control: public, max-age=31536000, immutable

# HTML 入口不缓存，保证每次拿到最新 hash
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
