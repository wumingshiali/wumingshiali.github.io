{
  "name": "web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:build": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:deploy": "vitest run tests/integration/wrangler-dev.test.ts",
    "test:all": "pnpm run typecheck && pnpm run build && pnpm run test:unit && pnpm run test:component && pnpm run test:build && pnpm run test:e2e && pnpm run test:deploy",
    "e2e:install": "playwright install --with-deps chromium",
    "new-post": "node scripts/new-post.mjs"
  },
  "dependencies": {
    "@giscus/vue": "^3.1.1",
    "@lucide/vue": "^1.18.0",
    "@noble/ciphers": "^2.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@unhead/vue": "^3.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "markdown-it": "^15.0.0",
    "reka-ui": "^2.9.10",
    "shadcn-vue": "^2.7.4",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.38",
    "vue-router": "^5.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.6",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.1",
    "terser": "^5.48.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-html-minifier-terser": "^3.8.0",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5",
    "wrangler": "^4.105.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ],
    "overrides": {
      "brace-expansion@<=1.1.15": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
      "brace-expansion@<=5.0.7": "5.0.9",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.6",
      "postcss@<=8.5.22": "8.5.26",
      "sharp@<0.35.0": "0.35.4",
      "hono@<4.12.34": "4.12.34",
      "@hono/node-server@<2.0.10": "2.1.1"
    }
  }
}
